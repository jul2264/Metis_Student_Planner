<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.canvas.Canvas?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="700.0" prefWidth="900.0" style="-fx-background-color: #0f1422;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.metis.controllers.NotesController">
   <children>
      <VBox spacing="10.0" AnchorPane.bottomAnchor="30.0" AnchorPane.leftAnchor="30.0" AnchorPane.rightAnchor="370.0" AnchorPane.topAnchor="30.0">
         <children>
            <Label style="-fx-font-size: 22px; -fx-text-fill: white;" text="🗒 Notes" />
            <HBox alignment="CENTER_LEFT" spacing="10.0">
               <children>
                  <TextField fx:id="noteTitleField" promptText="Enter note title" style="-fx-background-color:#1e2230; -fx-text-fill:white; -fx-prompt-text-fill:gray;" HBox.hgrow="ALWAYS" />
                  <Region HBox.hgrow="ALWAYS" />
                  <Button onAction="#switchToTextMode" text="Text" />
                  <Button onAction="#switchToDrawMode" text="Draw" />
                  <Button fx:id="clearCanvasButton" onAction="#clearCanvas" text="Clear" visible="false" />
                  <Button fx:id="saveButton" onAction="#saveNote" style="-fx-background-color:#3D6BF5; -fx-text-fill:white; -fx-background-radius:6;" text="Save Note" />
               </children>
            </HBox>
            <StackPane VBox.vgrow="ALWAYS">
               <children>
                  <TextArea fx:id="noteContentArea" promptText="Write your note here..." style="-fx-control-inner-background:#1e2230; -fx-text-fill:white; -fx-prompt-text-fill:gray;" wrapText="true" />
                  <Canvas fx:id="noteCanvas" height="540.0" visible="false" width="500.0" />
               </children>
            </StackPane>
         </children>
      </VBox>
      
      <VBox spacing="10.0" AnchorPane.bottomAnchor="30.0" AnchorPane.rightAnchor="30.0" AnchorPane.topAnchor="30.0">
         <children>
            <Label style="-fx-text-fill:white; -fx-font-size:16px;" text="Saved Notes" />
            <ListView fx:id="notesList" onMouseClicked="#loadSelectedNote" style="-fx-background-color:#1e2230; -fx-text-fill:white;" VBox.vgrow="ALWAYS" />
         </children>
      </VBox>
   </children>
</AnchorPane>